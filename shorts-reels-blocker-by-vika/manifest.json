{
  "manifest_version": 3,
  "name": "Shorts & Reels Blocker",
  "version": "1.0.0",
  "description": "Blocks YouTube Shorts and Instagram/Facebook Reels and hides their shelves and tabs.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocklist",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["hide.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*", "*://*.facebook.com/*"],
      "css": ["hide.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Shorts & Reels Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
